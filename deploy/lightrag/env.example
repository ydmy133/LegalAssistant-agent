# Copy to deploy/lightrag/.env and fill in secrets (do not commit .env)
# cp deploy/lightrag/env.example deploy/lightrag/.env

HOST=0.0.0.0
PORT=9621

# API key for LightRAG Server (must match LIGHTRAG_API_KEY on Java backend)
LIGHTRAG_API_KEY=change-me-lightrag-api-key

# LLM: DeepSeek OpenAI-compatible API (entity/relation extraction during indexing)
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_BINDING_API_KEY=

# Embedding: Ollama bge-m3 (must match ollama-init pull)
EMBEDDING_BINDING=ollama
EMBEDDING_BINDING_HOST=http://ollama:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# Storage / workspace (defaults are fine for Docker)
WORKSPACE=legal_assistant
SUMMARY_LANGUAGE=Chinese
LOG_LEVEL=INFO
